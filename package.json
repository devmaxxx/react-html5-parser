{
  "name": "react-html5-parser",
  "version": "0.2.0",
  "sideEffects": false,
  "description": "Fast, simple and small HTML to React and React Native parser, sanitized by default",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./native": {
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "src",
    "dist",
    "native",
    "README.md",
    "EXAMPLES.md"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "sizecheck": "size-limit",
    "build": "npm run clean && tsdown && publint",
    "build:size": "npm run build && npm run sizecheck",
    "test": "npm run typecheck && jest",
    "test:watch": "jest --watchAll",
    "release": "npm run test && npm run build:size && git tag $npm_package_version && git push && git push --tags && npm publish",
    "typecheck": "tsc --noEmit -p .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "author": "devmaxxx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaxxx/react-html5-parser.git"
  },
  "bugs": {
    "url": "https://github.com/devmaxxx/react-html5-parser/issues"
  },
  "keywords": [
    "html",
    "parser",
    "react",
    "react-html",
    "react-html-parser",
    "html-react-parser",
    "html-parser",
    "react-native",
    "sanitize",
    "dompurify"
  ],
  "devDependencies": {
    "@size-limit/esbuild": "^8.1.0",
    "@size-limit/file": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native": "^0.70.19",
    "htmlparser2": "^12.0.0",
    "jest": "^29.2.1",
    "jest-environment-jsdom": "^29.2.1",
    "prettier": "^2.7.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^8.1.0",
    "ts-jest": "^29.4.14",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "engines": {
    "node": ">=14.16"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setupTests.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[tj]sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities)/)"
    ]
  },
  "size-limit": [
    {
      "name": "parse (DOMPurify, HTML + SVG)",
      "path": "./dist/index.js",
      "import": "{ parse }",
      "limit": "15.3 kB"
    },
    {
      "name": "core parse (no sanitizer)",
      "path": "./dist/core.js",
      "import": "{ parse }",
      "limit": "3.05 kB"
    },
    {
      "name": "native parse (htmlparser2)",
      "path": "./dist/native.js",
      "import": "{ parse }",
      "ignore": [
        "react-native"
      ],
      "limit": "27 kB"
    }
  ],
  "dependencies": {
    "dompurify": "^3.4.17"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "domelementtype": "3.0.0",
    "domhandler": "6.0.1",
    "entities": "8.1.0",
    "htmlparser2": "12.0.0"
  }
}
